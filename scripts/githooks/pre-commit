#!/bin/sh
# Git-native pre-commit gate (zero external dependencies; POSIX sh).
# Enable with: sh scripts/githooks/install.sh   (sets core.hooksPath)
#
# The commit-hook subset of the L0 gates from .claude/CLAUDE.md, enforced on
# staged paths (the hooks do NOT run cargo test — that stays a manual L0
# step, and CI runs it as well):
#   - any staged file > 1 MB       -> reject
#   - staged *.rs / Cargo.*        -> cargo fmt --all --check
#   - staged crates/<dir>/...      -> cargo clippy -p <package> --all-targets
#                                     -- -D warnings  (package name read from
#                                     that directory's Cargo.toml, not the
#                                     directory name)
#   - staged *.md                  -> sh scripts/lint-markdown-content.sh
#
# Bypass everything with `git commit --no-verify`. CI runs on pull requests
# and on pushes to main (.github/workflows/ci.yml), so a feature branch is
# gated through its PR's CI Gate.
# Skip only clippy with `SKIP_CLIPPY=1 git commit ...` (any other value,
# including SKIP_CLIPPY=0, runs clippy): pre-commit leaves a marker and
# commit-msg appends `[skip-clippy]` to the message tail so that reviewers
# can see the skip.

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

skip_marker=$(git rev-parse --git-path SKIP_CLIPPY)
# Drop any stale marker from an aborted commit before deciding fresh.
rm -f "$skip_marker"

# NUL-safe staged listing: with -z, git emits raw paths (never C-quoted, so
# non-ASCII names like café.bin survive intact); tr turns the NUL separators
# into newlines for the POSIX-sh line loop below.
staged_list=$(mktemp)
trap 'rm -f "$staged_list"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR | tr '\0' '\n' >"$staged_list"
[ -s "$staged_list" ] || exit 0

fail() {
    echo "pre-commit: $1" >&2
    echo "pre-commit: commit blocked — fix the issue, or bypass with git commit --no-verify" >&2
    exit 1
}

# --- 1 MB staged-size cap ------------------------------------------------

max_bytes=1048576
while IFS= read -r f; do
    [ -n "$f" ] || continue
    blob=$(git ls-files -s -- "$f" | awk '{print $2}')
    [ -n "$blob" ] || continue
    size=$(git cat-file -s "$blob")
    if [ "$size" -gt "$max_bytes" ]; then
        fail "staged file '$f' is $size bytes — the limit is 1 MB ($max_bytes)"
    fi
done <"$staged_list"

# --- classify staged paths ------------------------------------------------

fmt_needed=0
md_needed=0
dirs=""
while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
        *.rs | Cargo.* | */Cargo.*)
            fmt_needed=1
            ;;
    esac
    case "$f" in
        crates/*/*)
            d=${f#crates/}
            d=${d%%/*}
            [ -n "$d" ] || continue
            case " $dirs " in
                *" $d "*) ;;
                *) dirs="$dirs $d" ;;
            esac
            ;;
    esac
    case "$f" in
        *.md) md_needed=1 ;;
    esac
done <"$staged_list"

# --- cargo fmt ------------------------------------------------------------

if [ "$fmt_needed" -eq 1 ]; then
    echo "pre-commit: cargo fmt --all --check"
    cargo fmt --all --check || fail "cargo fmt --all --check failed"
fi

# --- cargo clippy (touched crates only; SKIP_CLIPPY=1 skips) ---------------

if [ -n "$dirs" ]; then
    if [ "${SKIP_CLIPPY:-}" = "1" ]; then
        : > "$skip_marker"
        echo "pre-commit: SKIP_CLIPPY=1 — clippy skipped for:$dirs"
        echo "pre-commit: commit-msg will append [skip-clippy] to the message"
    else
        for d in $dirs; do
            toml="crates/$d/Cargo.toml"
            pkg=$(awk '
                /^[ \t]*\[package\][ \t]*$/ { inp = 1; next }
                /^[ \t]*\[/ { inp = 0 }
                inp && /^[ \t]*name[ \t]*=/ {
                    sub(/^[^"]*"/, "")
                    sub(/".*/, "")
                    print
                    exit
                }
            ' "$toml" 2>/dev/null)
            if [ -z "$pkg" ]; then
                echo "pre-commit: no package name found in $toml — clippy skipped for crates/$d/" >&2
                continue
            fi
            echo "pre-commit: cargo clippy -p $pkg --all-targets -- -D warnings"
            cargo clippy -p "$pkg" --all-targets -- -D warnings \
                || fail "cargo clippy -p $pkg failed (or skip with SKIP_CLIPPY=1)"
        done
    fi
fi

# --- markdown content lint --------------------------------------------------

if [ "$md_needed" -eq 1 ]; then
    echo "pre-commit: sh scripts/lint-markdown-content.sh"
    sh scripts/lint-markdown-content.sh || fail "markdown content lint failed"
fi

exit 0

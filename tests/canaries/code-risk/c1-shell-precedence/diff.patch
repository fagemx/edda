+#!/bin/sh
+set -eu
+
+# Deploy helper. Fast path first; on failure, clean the temp dir and
+# fall back to the slow path.
+
+TMP=$(mktemp -d)
+
+fast_build "$TMP" || cleanup "$TMP" && git rm -rf . --quiet
+slow_build "$TMP"
+
+echo "deploy ok"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task.session payload",
  "description": "Unstable payload inventory; not a v1 stability commitment.",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "integer",
      "minimum": 0
    },
    "acp_session_id": {
      "type": "string"
    },
    "agent_kind": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "brief_event_id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9]+$",
      "maxLength": 68
    },
    "brief_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lease_owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_id"
  ],
  "additionalProperties": true,
  "dependentRequired": {
    "brief_event_id": ["brief_digest", "agent_kind", "session_id", "attempt", "lease_owner"],
    "brief_digest": ["brief_event_id", "agent_kind", "session_id", "attempt", "lease_owner"],
    "lease_owner": ["brief_event_id", "brief_digest", "agent_kind", "session_id", "attempt"]
  },
  "anyOf": [
    {
      "required": [
        "acp_session_id"
      ]
    },
    {
      "required": [
        "agent_kind",
        "session_id",
        "attempt"
      ]
    }
  ]
}

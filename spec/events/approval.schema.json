  "properties": {
    "draft_id": {
      "type": "string"
    },
    "draft_sha256": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    }

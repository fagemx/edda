    "engine_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "redaction_level": {
      "type": "string"
    },
    "village_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "context_blob": {
      "type": "string"
    },
    "result_blob": {
      "type": "string"
    },
    "context_inline": {},
    "result_inline": {}
  },
  "required": [

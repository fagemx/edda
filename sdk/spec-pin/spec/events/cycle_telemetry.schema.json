{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cycle_telemetry payload",
  "description": "Core accepts arbitrary JSON; object properties describe the HTTP telemetry writer.",
  "properties": {
    "cycle_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "total_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "token_usage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "input_tokens",
                  "output_tokens"
                ],
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "duration_ms",
          "token_usage",
          "status"
        ],
        "additionalProperties": true
      }
    },
    "cost": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "total_usd": {
              "type": "number"
            },
            "breakdown": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "total_usd"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {}
  },
  "required": [],
  "additionalProperties": true
}

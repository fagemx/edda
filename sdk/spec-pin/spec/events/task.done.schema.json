{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task.done payload",
  "description": "Unstable payload inventory; not a v1 stability commitment.",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "integer",
      "minimum": 0
    },
    "receipt": {
      "type": "string",
      "pattern": "\\S"
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "task_id",
    "receipt",
    "evidence_paths"
  ],
  "additionalProperties": true
}

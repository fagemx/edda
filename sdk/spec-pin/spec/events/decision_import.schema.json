{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision_import payload",
  "description": "Layer 1 v1 payload.",
  "type": "object",
  "properties": {
    "role": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "local",
                "shared",
                "global"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "affected_paths": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "review_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversibility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "village_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": true
    },
    "source_project_id": {
      "type": "string"
    },
    "source_project_name": {
      "type": "string"
    },
    "source_event_id": {
      "type": "string"
    }
  },
  "required": [
    "role",
    "text",
    "tags",
    "decision",
    "source_project_id",
    "source_project_name",
    "source_event_id"
  ],
  "additionalProperties": true
}
